{
  "name": "claude-cache-watcher",
  "displayName": "Claude Code Turn Monitor",
  "description": "Real-time status bar monitor for Claude Code — context fill %, cache hit rate, and per-turn API-equivalent cost after every response.",
  "version": "1.0.12",
  "publisher": "shivaraj-arch",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "icon.png",
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Claude Code Cache Watcher",
      "properties": {
        "claudeWatcher.planType": {
          "type": "string",
          "enum": [
            "subscription",
            "api"
          ],
          "enumDescriptions": [
            "Pro / Max / Team — flat monthly fee. Costs shown are API-equivalent; tooltip shows your savings vs API rates.",
            "API key (pay-as-you-go) — costs shown are real charges."
          ],
          "default": "subscription",
          "description": "Your Claude plan type."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "author": {
    "name": "Shivaraj",
    "email": "shivrajsys@gmail.com",
    "url": "https://github.com"
  },
  "bugs": {
    "url": "https://github.com/claude-cache-watcher/issues"
  },
  "homepage": "https://github.com/claude-cache-watcher#readme"
}
