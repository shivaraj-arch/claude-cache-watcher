{
  "name": "claude-cache-watcher",
  "displayName": "Claude Code Turn Usage Monitor",
  "description": "Real-time status bar monitor for Claude Code — context fill %, cache hit rate, and per-turn API-equivalent cost after every response.",
  "version": "1.0.17",
  "publisher": "shivaraj-arch",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai",
    "token",
    "cost",
    "cache",
    "context",
    "usage",
    "status bar",
    "monitor",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Claude Code Turn Monitor",
      "properties": {
        "claudeWatcher.planType": {
          "type": "string",
          "enum": [
            "subscription",
            "api"
          ],
          "enumDescriptions": [
            "Pro / Max / Team — flat monthly fee. Costs shown are API-equivalent, not actual charges.",
            "API key (pay-as-you-go) — costs shown are real charges."
          ],
          "default": "subscription",
          "description": "Your Claude plan type. Controls the ~ prefix on costs."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shivaraj-arch/claude-cache-watcher"
  },
  "author": {
    "name": "Shivaraj",
    "url": "https://github.com/shivaraj-arch"
  },
  "bugs": {
    "url": "https://github.com/shivaraj-arch/claude-cache-watcher/issues"
  },
  "homepage": "https://github.com/shivaraj-arch/claude-cache-watcher#readme",
  "license": "MIT"
}
